<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import tourplanner.tourplanner.model.TransportType?>

<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<GridPane xmlns="http://javafx.com/javafx"
          xmlns:fx="http://javafx.com/fxml"
          hgap="10" vgap="10">
    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>

    <Label text="Name" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
    <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

    <Label text="From" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
    <TextField fx:id="fromField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

    <Label text="To" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
    <TextField fx:id="toField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

    <Label text="Distance (km)" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
    <TextField fx:id="distField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

    <Label text="Estimated (min)" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
    <TextField fx:id="estimateField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

    <Label text="Transport" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
    <ComboBox fx:id="transportCombo" promptText="Transport" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

    <Label text="Description" GridPane.rowIndex="6" GridPane.columnIndex="0" GridPane.valignment="TOP"/>
    <TextArea fx:id="descriptionArea" prefRowCount="4" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
</GridPane>